{
  "name": "HARNESS-SMOKE-20S",
  "description": "Harness validation only; never publish as gateway performance evidence",
  "duration_s": 20,
  "warmup_s": 2,
  "stage_seconds": 4,
  "stage_rps": [20, 30, 40, 50, 60],
  "traffic_weights": {"normal": 70, "auth": 10, "waf": 5, "banned": 5, "rate": 5, "routing": 5},
  "websocket_clients": 100,
  "semantic_min": 0.95,
  "fault_available_min": 0.80,
  "recovery_available_min": 0.80,
  "rate_limit": {"capacity": 3, "refill_per_sec": 1},
  "products": ["bronx"],
  "events": [
    {"at_s": 2, "action": "reload-valid"},
    {"at_s": 4, "action": "reload-invalid"},
    {"at_s": 5, "action": "upstream-c-503-on"},
    {"at_s": 6, "action": "snapshot-fault-c"},
    {"at_s": 7, "action": "upstream-c-clear"},
    {"at_s": 8, "action": "upstream-d-slow-on"},
    {"at_s": 9, "action": "snapshot-fault-d"},
    {"at_s": 10, "action": "upstream-d-clear"},
    {"at_s": 10, "action": "upstream-e-offline-on"},
    {"at_s": 11, "action": "snapshot-fault-e"},
    {"at_s": 12, "action": "upstream-e-clear"},
    {"at_s": 12, "action": "trace-on"},
    {"at_s": 13, "action": "observe-probe"},
    {"at_s": 14, "action": "trace-off"},
    {"at_s": 14, "action": "security-unban"},
    {"at_s": 16, "action": "security-seed"},
    {"at_s": 16, "action": "restart-control"},
    {"at_s": 17, "action": "observe-verify"},
    {"at_s": 17, "action": "security-unban"},
    {"at_s": 18, "action": "log-rotate"},
    {"at_s": 18, "action": "snapshot-final-window"}
  ]
}
