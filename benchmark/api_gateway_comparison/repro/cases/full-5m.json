{
  "name": "G-FULL-1000",
  "description": "Five-minute fixed-1000-RPS integrated capability, performance, resource and recovery run",
  "duration_s": 300,
  "warmup_s": 60,
  "stage_seconds": 60,
  "stage_rps": [1000, 1000, 1000, 1000, 1000],
  "traffic_weights": {"normal": 70, "auth": 10, "waf": 5, "banned": 5, "rate": 5, "routing": 5},
  "websocket_clients": 100,
  "semantic_min": 0.999,
  "fault_available_min": 0.95,
  "recovery_available_min": 0.95,
  "rate_limit": {"capacity": 20, "refill_per_sec": 10},
  "products": ["bronx", "spring", "kong-dbless", "kong-postgres"],
  "events": [
    {"at_s": 60, "action": "reload-valid"},
    {"at_s": 75, "action": "reload-invalid"},
    {"at_s": 90, "action": "upstream-c-503-on"},
    {"at_s": 99, "action": "snapshot-fault-c"},
    {"at_s": 108, "action": "upstream-c-clear"},
    {"at_s": 110, "action": "snapshot-recovery-c"},
    {"at_s": 112, "action": "upstream-d-slow-on"},
    {"at_s": 121, "action": "snapshot-fault-d"},
    {"at_s": 130, "action": "upstream-d-clear"},
    {"at_s": 132, "action": "snapshot-recovery-d"},
    {"at_s": 134, "action": "upstream-e-offline-on"},
    {"at_s": 143, "action": "snapshot-fault-e"},
    {"at_s": 150, "action": "restart-control"},
    {"at_s": 152, "action": "upstream-e-clear"},
    {"at_s": 154, "action": "snapshot-recovery-e"},
    {"at_s": 180, "action": "security-unban"},
    {"at_s": 195, "action": "security-seed"},
    {"at_s": 195, "action": "trace-on"},
    {"at_s": 200, "action": "observe-probe"},
    {"at_s": 225, "action": "trace-off"},
    {"at_s": 225, "action": "security-unban"},
    {"at_s": 226, "action": "observe-verify"},
    {"at_s": 240, "action": "log-rotate"},
    {"at_s": 270, "action": "snapshot-final-window"}
  ]
}
