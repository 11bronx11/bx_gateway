server:
  address: "127.0.0.1:@BRONX_PORT@"
  admin_address: "127.0.0.1:@ADMIN_PORT@"
  io_workers: @IO_WORKERS@
  maintenance: false

upstreams:
  - name: bench
    lb: round_robin
    timeout:
      total_ms: 1000
      connect_ms: 200
      read_ms: 1000
    limits:
      max_inflight: 8192
    circuit_breaker:
      failure_threshold: 100
      window_ms: 10000
      min_requests: 1000
      failure_rate: 100
      slow_ms: 1000
      slow_rate: 100
      open_timeout_ms: 1000
      max_open_timeout_ms: 1000
      half_open_max_requests: 1
      half_open_successes: 1
      failure_statuses: [500, 502, 503, 504]
    connection_pool:
      max_idle: 1024
      idle_timeout_ms: 60000
    health_check:
      enabled: false
    endpoints:
      - { host: "127.0.0.1", port: @UPSTREAM_PORT@, weight: 1 }

routes:
  - name: bench
    match_type: prefix
    path: /bench
    upstream: bench
    strip_prefix: false
    methods: [GET]
    auth: none

trusted_proxies: []

cors:
  enabled: false

auth:
  jwt:
    enabled: false
    algo: HS256
  api_key:
    header: X-Api-Key
    keys: []
  forward:
    enabled: false

ip_filter:
  enabled: false
  mode: denylist
  cidrs: []

ip_policy:
  waf:
    enabled: false
  rate_report:
    enabled: false
